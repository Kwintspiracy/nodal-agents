# Playwright auth session state (contains session tokens — never commit)
**/tests/e2e/.auth/
# Local Claude Code per-machine settings + runtime artefacts (scheduled
# tasks, scratch worktrees, lockfiles). Nothing under .claude/ or
# .clone/ should be committed; the harness writes there freely between
# sessions.
.claude/
.clone/
# Debug / scratch scripts (never commit — may contain secrets)
apps/web/check-jobs*.ts
apps/web/test-single.ts
response.html
# Throwaway manual Playwright verifications (sub-agent scratch space; the
# real e2e suite lives under apps/web/tests/e2e/)
apps/web/tests/manual/
# Inbound design handoff bundles (Claude Design exports, screenshots,
# reference uploads). The product is the implementation, not these.
design/
start-pg-screenshots.ts

# Runtime image outputs dropped by the runner / ComfyUI during live tests
apps/runner/ComfyUI_*.png
apps/runner/zim_*.png
/test-screenshots/

# Local dogfood / diagnostic Playwright artifacts created by sub-agents during
# live sessions. They hardcode Windows paths (D:\…\test-screenshots) and need a
# running local stack, so they are NOT portable — kept on disk but out of the
# committed e2e suite (vitest already excludes tests/e2e/; CI only runs vitest).
apps/web/tests/e2e/dogfood-audit*.spec.ts
apps/web/tests/e2e/bell-diag.spec.ts
apps/web/tests/e2e/bell-approval.spec.ts
apps/web/tests/e2e/command-execution-yolo.spec.ts
apps/web/playwright.local-trust.config.ts
apps/web/pw-onboarding-verify.cjs
apps/web/pw-onboarding-verify.mjs
/dogfood-root-context.md
