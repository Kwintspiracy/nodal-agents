{
  "name": "nodal-agents-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "All-Node monorepo for the Nodal-Agents platform.",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise --config .dependency-cruiser.cjs apps packages",
    "secrets:check": "node scripts/check-no-secrets.mjs",
    "pack:build": "node scripts/build-pack.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.7.0",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^9.39.4",
    "prettier": "^3.4.2",
    "turbo": "^2.9.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.0.12"
    }
  }
}
