{
  "name": "nodal-agents-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "All-Node monorepo for the Nodal-Agents platform.",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:scripts": "vitest run scripts/tests",
    "typecheck": "turbo typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise --config .dependency-cruiser.cjs apps packages",
    "secrets:check": "node scripts/check-no-secrets.mjs",
    "hygiene:check": "node scripts/check-commit-hygiene.mjs --all",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "release:check": "node scripts/release-check.mjs",
    "pack:build": "node scripts/build-pack.mjs",
    "pack:smoke": "node scripts/smoke-pack.mjs",
    "pack:upgrade": "node scripts/smoke-upgrade.mjs",
    "bench": "pnpm --filter @nodal-agents/bench bench",
    "inventory": "node scripts/inventory/collect.mjs audit/inventory.json && node scripts/inventory/render.mjs audit/inventory.json audit/inventaire.html"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.7.0",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^9.39.4",
    "prettier": "^3.4.2",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  }
}
