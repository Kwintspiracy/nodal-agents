{
  "name": "@nodal-agents/device-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Connect a device to Nodal: pairing, the event stream and the conversation gestures, with no runtime dependency.",
  "main": "./src/nodal-device.ts",
  "types": "./src/nodal-device.ts",
  "exports": {
    ".": "./src/nodal-device.ts",
    "./snippet": "./src/snippet.ts"
  },
  "scripts": {
    "gen": "tsx scripts/gen-protocol.ts",
    "build": "node scripts/build.mjs",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nodal-agents/shared": "workspace:*",
    "@nodal-agents/test-kit": "workspace:*",
    "@types/node": "^25.7.0",
    "esbuild": "^0.27.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
