#!/bin/sh
# Versioned pre-push hook (enabled with the others by `pnpm hooks:install`).
#
# Runs scripts/check-private-names.mjs on the commits about to be pushed: their
# added lines and their messages. The list of private names lives outside the
# repository (NODAL_PRIVATE_NAMES, default ~/.nodalai/private-names.txt); with no
# list the check says so and passes. Skipped on request: NODAL_SKIP_HYGIENE=1.
# Without the versioned hooks path: git config core.hooksPath .githooks

set -e

if [ "$NODAL_SKIP_HYGIENE" = "1" ]; then
  echo "pre-push: skipped (NODAL_SKIP_HYGIENE=1)"
  exit 0
fi

zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # a deletion pushes no commit
  if [ "$remote_sha" = "$zero" ]; then
    # New branch: what it adds over origin/main, else its whole history.
    base=$(git merge-base origin/main "$local_sha" 2>/dev/null || true)
    range="${base:+$base..}$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi
  node scripts/check-private-names.mjs --git-range "$range"
done
